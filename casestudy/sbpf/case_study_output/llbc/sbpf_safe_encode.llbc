"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`format()`]: ../../std/fmt/fn.format.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"format_arguments"},"generics":{"regions":[{"index":0,"name":"'a","variance":"Covariant","mutability":"Shared"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,8],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":11,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeInclusive",0]}],"span":{"data":{"file_id":12,"beg":{"line":357,"col":0},"end":{"line":357,"col":30}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range bounded inclusively below and above (`start..=end`)."},{"DocComment":""},{"DocComment":" The `RangeInclusive` `start..=end` contains all values with `x >= start`"},{"DocComment":" and `x <= end`. It is empty unless `start <= end`."},{"DocComment":""},{"DocComment":" This iterator is [fused], but the specific values of `start` and `end` after"},{"DocComment":" iteration has finished are **unspecified** other than that [`.is_empty()`]"},{"DocComment":" will return `true` once no more values will be produced."},{"DocComment":""},{"DocComment":" [fused]: crate::iter::FusedIterator"},{"DocComment":" [`.is_empty()`]: RangeInclusive::is_empty"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..=end` syntax is a `RangeInclusive`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((3..=5), std::ops::RangeInclusive::new(3, 5));"},{"DocComment":" assert_eq!(3 + 4 + 5, (3..=5).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]); // This is a `RangeInclusive`"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"RangeInclusive"},"generics":{"regions":[],"types":[{"index":0,"name":"Idx","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":12,"item_meta":{"name":[{"Ident":["solana_sbpf",0]},{"Ident":["safe_mode",0]},{"Ident":["x86",0]},{"Ident":["X86Register",0]}],"span":{"data":{"file_id":0,"beg":{"line":23,"col":0},"end":{"line":48,"col":1}},"generated_from_span":null},"source_text":"pub enum X86Register {\n    RAX = 0,\n    RCX = 1,\n    RDX = 2,\n    RBX = 3,\n    RSP = 4,\n    RBP = 5,\n    RSI = 6,\n    RDI = 7,\n    R8 = 8,\n    R9 = 9,\n    R10 = 10,\n    R11 = 11,\n    R12 = 12,\n    R13 = 13,\n    R14 = 14,\n    R15 = 15,\n    MM0 = 16,\n    MM1 = 17,\n    MM2 = 18,\n    MM3 = 19,\n    MM4 = 20,\n    MM5 = 21,\n    MM6 = 22,\n    MM7 = 23,\n}","attr_info":{"attributes":[{"Unknown":{"path":"allow","args":"dead_code, clippy::upper_case_acronyms"}}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":0,"beg":{"line":24,"col